# .clangd —— 由 ICBSP/tools/integrate.py 生成（工程 {{PROJECT}}，预设 {{PRESET}}）
#
# 为什么需要它：clangd 不会自己去 CMake 构建目录里找 compile_commands.json。
# 不给它，它就只能靠猜参数，于是 Cortex-M 相关的 -mcpu / -mfpu / 系统头全丢，头文件一路标红。
#
# 【CompilationDatabase】相对宿主根目录的构建目录，值取自 CMakePresets.json 里该预设的 binaryDir。
#   换预设（例如改看 Release）时二选一：
#     1. 手动改下面这行路径，或
#     2. 删掉本文件后重跑 tools/integrate.py（脚本只在文件不存在时生成）
#   注意：本文件与 .vscode/settings.json 里的 clangd.arguments 是两处配置，保持一致即可；
#   只想留一处时，删掉另一处对应的那一项。
#
# 【--query-driver 不能写在这里】它是 clangd 自己的命令行参数，写进 CompileFlags 会被当成编译器
#   参数转给 arm-none-eabi-gcc，报 Unknown argument（诊断码 drv_unknown_argument）。
#   正确位置是启动 clangd 的地方：VS Code 的 "clangd.arguments"，或命令行
#   clangd --query-driver=/path/to/arm-none-eabi-*。不设它会报“找不到 stdint.h”。
#
# 【-Wno-unknown-warning-option】编译数据库里出现 GCC 专有的告警选项时不刷屏。
CompileFlags:
  CompilationDatabase: {{COMPILE_COMMANDS_DIR}}
  Add:
    - -Wno-unknown-warning-option

Diagnostics:
  # 交叉编译的编译数据库里出现 clang 不认识的参数时，别把整行当成代码错误
  Suppress:
    - unknown-argument

---
# ---- 库的 templates/ 不是编译单元 ----
# 里面的 .hpp / .cpp 只是给宿主抄的样例，不参与构建。若让 clangd 也按工程配置解析它们：
#   - 会冒出一堆假错误（模板没有你的 CubeMX 句柄、也没有宿主的上下文）
#   - 同名文件互相干扰：templates/user/board/board_cfg.hpp 与宿主 user/board/board_cfg.hpp
#     同名，跳转 / 补全容易指到模板那份
# 所以这一段让模板目录：不用宿主的编译数据库、不进后台索引、不报诊断。
If:
  PathMatch: .*templates/.*
CompileFlags:
  CompilationDatabase: None
Index:
  Background: Skip
Diagnostics:
  Suppress: '*'

---
# ---- 第三方库：CubeMX 的 Drivers/（CMSIS + HAL）与 FreeRTOS ----
# 这些代码不归宿主维护，报错/告警没有意义（交叉工具链的专有选项、HAL 里的写法差异都会刷屏）。
# 所以只屏蔽诊断，**保留编译数据库与后台索引**：跳进 HAL / FreeRTOS 看实现仍然正常。
If:
  PathMatch:
    - .*Drivers/.*
    - .*Middlewares/Third_Party/FreeRTOS/.*
Diagnostics:
  Suppress: '*'

---
# ---- CubeMX 生成的 Core/Inc：不报诊断 ----
# main.h / stm32h7xx_hal_conf.h / gpio.h / tim.h / usart.h / FreeRTOSConfig.h 都是 CubeMX
# 生成的，下次重新生成会被覆盖，标红没有意义。
# 只屏蔽诊断：编译数据库与索引保留，跳进这些头文件看宏定义仍然正常。
# 注意不含 Core/Src：那里的 USER CODE 段是宿主自己写的，要保留诊断。
If:
  PathMatch: .*Core/Inc/.*
Diagnostics:
  Suppress: '*'
