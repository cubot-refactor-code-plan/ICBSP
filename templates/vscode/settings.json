{
    // CMake 预设把编译数据库放在 {{COMPILE_COMMANDS_DIR}}/，clangd 默认只找 build/，需显式指定
    // （先执行一次 cmake --preset {{PRESET}}）。这里是相对路径，相对 VS Code 的 ${workspaceFolder}。
    // 用命令行参数指定后，库代码也用宿主工程的编译数据库，跳转与补全才对得上。
    "clangd.arguments": [
        "--compile-commands-dir={{COMPILE_COMMANDS_DIR}}",
        "--query-driver={{QUERY_DRIVER}}"
    ],
    // 调试时变量按自然类型显示（寄存器位域不会显示成十进制大数）
    "cortex-debug.variableUseNaturalFormat": true,
    "cmake.useCMakePresets": "always",
    // 状态栏按钮（Task Buttons 插件 spencerwmiles.vscode-task-buttons），对应 tasks.json 里的任务 label；
    // 生成 Flash/ 时 integrate.py 再追加烧录按钮（templates/vscode/settings_flash.json）
    "VsCodeTaskButtons.showCounter": false,
    "VsCodeTaskButtons.tasks": [
        {
            "label": "[🔨 编译]",
            "task": "Build",
            "tooltip": "编译项目"
        },
        {
            "label": "[🧹 重新编译]",
            "task": "Clean_Rebuild",
            "tooltip": "先清理再重新编译"
        },
        {
            "label": "[🗑️ 清理]",
            "task": "Clean",
            "tooltip": "仅清理构建产物"
        }
    ],
    // 分区注释只认一种写法：`/* ==================== 标题 ==================== */` … `/* ==================== */`
    // 等号**正好 20 个**（不是 {16,}）；每个区必须成对收尾，**不能嵌套，全部扁平化**。
    // `// ----------------` 这种行注释不再识别。说明见 docs/编辑器配置.md
    "outlinePlus.regionBoundaryPatternByLanguageId": {
        "c": {
            "startRegex": "^\\s*/\\* ={20} (.+) ={20} \\*/\\s*$",
            "endRegex": "^\\s*/\\* ={20} \\*/\\s*$"
        },
        "cpp": {
            "startRegex": "^\\s*/\\* ={20} (.+) ={20} \\*/\\s*$",
            "endRegex": "^\\s*/\\* ={20} \\*/\\s*$"
        }
    }
}
